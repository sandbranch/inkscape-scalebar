<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Figure Panels</name>
    <id>org.sandbranch.filter.figure-panels</id>
    <param name="tab" type="notebook">
        <page name="layout" gui-text="Layout">
            <param name="width" type="float" min="10" max="2000" precision="1" gui-text="Figure width (mm):" gui-description="The rows fill exactly this width. Journals: often 85 mm (one column) or 180 mm (full width).">180</param>
            <param name="columns" type="int" min="1" max="20" gui-text="Panels per row:">2</param>
            <param name="gap" type="float" min="0" max="50" precision="1" gui-text="Gap between panels (mm):">2.0</param>
            <param name="order" type="optiongroup" appearance="combo" gui-text="Order:">
                <option value="reading">As they lie now, row by row</option>
                <option value="selection">In the order I selected them</option>
            </param>
        </page>
        <page name="labels" gui-text="Labels">
            <param name="labels" type="optiongroup" appearance="combo" gui-text="Panel letters:">
                <option value="upper">A, B, C</option>
                <option value="lower">a, b, c</option>
                <option value="upper-paren">(A), (B), (C)</option>
                <option value="lower-paren">(a), (b), (c)</option>
                <option value="none">None</option>
            </param>
            <param name="label_size" type="float" min="4" max="72" precision="1" gui-text="Letter size (pt):">10</param>
            <param name="label_color" type="optiongroup" appearance="combo" gui-text="Letter colour:">
                <option value="auto">Automatic (white on dark, black on light)</option>
                <option value="#000000">Black</option>
                <option value="#ffffff">White</option>
            </param>
            <param name="font_family" type="string" gui-text="Font:">sans-serif</param>
        </page>
        <page name="bars" gui-text="Scale bars">
            <param name="scalebars" type="bool" gui-text="Scale bars of one length on all calibrated panels">true</param>
            <param name="position" type="optiongroup" appearance="combo" gui-text="Corner:">
                <option value="bottom-right">Bottom right</option>
                <option value="bottom-left">Bottom left</option>
                <option value="top-right">Top right</option>
                <option value="top-left">Top left</option>
            </param>
            <param name="color" type="optiongroup" appearance="combo" gui-text="Colour:">
                <option value="auto">Automatic</option>
                <option value="white">White</option>
                <option value="black">Black</option>
            </param>
            <param name="label" type="bool" gui-text="Show the length">true</param>
            <param name="font_size" type="float" min="0.5" max="20" precision="1" gui-text="Text size (% of panel width):">4.0</param>
            <param name="thickness" type="float" min="0.1" max="10" precision="1" gui-text="Bar thickness (% of panel width):">1.2</param>
            <param name="margin" type="float" min="0" max="25" precision="1" gui-text="Distance from the edge (% of panel width):">4.0</param>
            <label>The pixel size comes from each image file, or from a calibration stored by Scale Bar. The length is one round number for all panels, about a fifth of the narrowest (the part that shows, for a cropped image). When the panels' magnifications differ more than tenfold, each panel gets a length of its own instead.</label>
        </page>
    </param>
    <effect>
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="Images"/>
        </effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">panels.py</command>
    </script>
</inkscape-extension>
