<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Scale Bar</name>
    <id>org.sandbranch.filter.scalebar</id>
    <param name="tab" type="notebook">
        <page name="bar" gui-text="Scale bar">
            <param name="length" type="string" gui-text="Length:" gui-description="auto (about a fifth of the image width), or a length such as 20 µm, 500 nm, 1 mm">auto</param>
            <param name="position" type="optiongroup" appearance="combo" gui-text="Corner:">
                <option value="bottom-right">Bottom right</option>
                <option value="bottom-left">Bottom left</option>
                <option value="top-right">Top right</option>
                <option value="top-left">Top left</option>
            </param>
            <param name="color" type="optiongroup" appearance="combo" gui-text="Colour:">
                <option value="auto">Automatic (white on dark, black on light)</option>
                <option value="white">White</option>
                <option value="black">Black</option>
            </param>
            <param name="box" type="optiongroup" appearance="combo" gui-text="Background:">
                <option value="none">None</option>
                <option value="dark">Dark box</option>
                <option value="light">Light box</option>
            </param>
            <param name="label" type="bool" gui-text="Show the length">true</param>
            <param name="font_family" type="string" gui-text="Font:">sans-serif</param>
            <param name="font_size" type="float" min="0.5" max="20" precision="1" gui-text="Text size (% of image width):">4.0</param>
            <param name="thickness" type="float" min="0.1" max="10" precision="1" gui-text="Bar thickness (% of image width):">1.2</param>
            <param name="margin" type="float" min="0" max="25" precision="1" gui-text="Distance from the edge (% of image width):">4.0</param>
        </page>
        <page name="calibration" gui-text="Calibration">
            <param name="source" type="optiongroup" appearance="radio" gui-text="Pixel size from:">
                <option value="auto">The image file, or a pixel size stored earlier</option>
                <option value="manual">This pixel size:</option>
                <option value="line">A line I drew along a known length:</option>
            </param>
            <param name="pixel_size" type="string" gui-text="Pixel size:" gui-description="Size of one pixel, such as 0.325 µm or 2.5 nm">0.1 µm</param>
            <param name="line_length" type="string" gui-text="Length of the line:" gui-description="For example the length of a scale bar burnt into the image: 50 µm">10 µm</param>
            <label xml:space="preserve">Read from the file: OME-TIFF, ImageJ/Fiji, Olympus/Evident cellSens and FluoView, Nikon NIS-Elements, Leica LAS X and TCS, Hamamatsu NDPI, Thermo Fisher/FEI and Zeiss SEM, Gatan DigitalMicrograph and JEOL SightX TIFFs, and the Zeiss ZEN metadata file next to an image.

With nothing selected, every image in the drawing gets a scale bar.

For PNG or JPEG images, type the pixel size in, or select the image together with a line drawn along something of known length. Either is stored on the image, so later runs (after resizing it, say) need no input.</label>
        </page>
    </param>
    <effect>
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="Images"/>
        </effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">scalebar.py</command>
    </script>
</inkscape-extension>
